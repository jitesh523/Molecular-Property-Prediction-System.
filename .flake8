[flake8]
# Code quality configuration for flake8
max-line-length = 120
extend-ignore = E203, W503, E501
exclude = .git, __pycache__, venv, .venv, build, dist, .egg-info
max-complexity = 10

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F403,D
    docs/*:E501,D

# Docstring conventions (pydocstyle)
docstring-convention = google
